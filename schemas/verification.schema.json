{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai02:verification:0.1.0",
  "type": "object",
  "required": ["version", "bundle_id", "claims_sha256", "evidence_sha256", "policy_sha256", "results", "question_confidence"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "0.1.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "claims_sha256": {"$ref": "#/$defs/hash"},
    "evidence_sha256": {"$ref": "#/$defs/hash"},
    "policy_sha256": {"$ref": "#/$defs/hash"},
    "question_confidence": {"type": "object", "required": ["model_elicited", "empirical_calibrated"]},
    "selection": {"type": "object", "required": ["action", "reason_codes"], "properties": {"action": {"enum": ["answer", "review", "abstain"]}}},
    "results": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["claim_id", "claim_type", "text", "answer_span", "state", "support", "contradictions", "numeric_checks", "reason_codes", "sources_considered", "confidence", "suggested_action", "unresolved_requirements"],
      "additionalProperties": false,
      "properties": {
        "claim_id": {"type": "string", "minLength": 1}, "claim_type": {"enum": ["text", "numeric", "opinion"]},
        "text": {"type": "string", "minLength": 1},
        "answer_span": {"$ref": "#/$defs/span"},
        "state": {"enum": ["supported", "contradicted", "insufficient_evidence", "not_fact_checkable"]},
        "support": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "contradictions": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "numeric_checks": {"type": "array", "items": {"type": "object", "required": ["status", "failures", "source_id"], "properties": {"status": {"enum": ["pass", "fail"]}, "failures": {"$ref": "#/$defs/strings"}, "source_id": {"type": "string"}}}},
        "reason_codes": {"$ref": "#/$defs/strings"}, "sources_considered": {"type": "integer", "minimum": 0},
        "confidence": {"type": "object", "required": ["model_elicited", "verifier", "empirical_calibrated", "unavailable_reason"]},
        "suggested_action": {"enum": ["answer", "review", "abstain"]}, "unresolved_requirements": {"$ref": "#/$defs/strings"}
      }
    }}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "span": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "citation": {
      "type": "object",
      "required": ["source_id", "version", "sha256", "published_at", "as_of", "retrieved_at", "access_scope", "quality", "license", "quote_span", "quote"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}, "published_at": {"type": "string", "format": "date-time"},
        "as_of": {"type": "string", "format": "date-time"}, "retrieved_at": {"type": "string", "format": "date-time"},
        "access_scope": {"type": "string", "minLength": 1}, "quality": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}, "quote_span": {"$ref": "#/$defs/span"}
      }
    }
  }
}
